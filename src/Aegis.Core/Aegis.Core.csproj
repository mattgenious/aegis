<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Aegis</RootNamespace>
    <PackageId>Aegis.Core</PackageId>
    <Version>0.1.2</Version>
    <Authors>mattgenious</Authors>
    <Description>Reusable contracts, session registry infrastructure, state normalization, prompt rendering, and cell records for Aegis agent backends.</Description>
    <RepositoryUrl>https://github.com/mattgenious/aegis</RepositoryUrl>
    <PackageTags>agents;cli;aegis;automation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\prompts\**\*.md" Link="prompts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="contentFiles\any\any\prompts\%(RecursiveDir)%(Filename)%(Extension)" PackageCopyToOutput="true" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
