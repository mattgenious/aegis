<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>aegis</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aegis</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <CellUiDirectory>$(MSBuildProjectDirectory)\CellUi</CellUiDirectory>
    <BuildCellUiOnPublish Condition="'$(BuildCellUiOnPublish)' == ''">true</BuildCellUiOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aegis.Backends\Aegis.Backends.csproj" />
    <ProjectReference Include="..\Aegis.Core\Aegis.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="CellUi\dist\**\*" />
    <None Remove="CellUi\dist\**\*" />
  </ItemGroup>

  <Target Name="BuildCellUiForPublish" BeforeTargets="ComputeFilesToPublish" Condition="'$(BuildCellUiOnPublish)' == 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(CellUiDirectory)" Condition="Exists('$(CellUiDirectory)\package-lock.json')" />
    <Exec Command="npm install" WorkingDirectory="$(CellUiDirectory)" Condition="!Exists('$(CellUiDirectory)\package-lock.json')" />
    <Exec Command="npm run build" WorkingDirectory="$(CellUiDirectory)" />

    <ItemGroup>
      <CellUiDistFile Include="$(CellUiDirectory)\dist\**\*" />
      <ResolvedFileToPublish Include="@(CellUiDistFile)">
        <RelativePath>CellUi\dist\%(CellUiDistFile.RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="WriteLegacyCliAliasShims" AfterTargets="Publish">
    <PropertyGroup>
      <LegacyWindowsShimCommand>&quot;%~dp0aegis.exe&quot; %25*</LegacyWindowsShimCommand>
      <LegacyUnixShimLine2>self=$0</LegacyUnixShimLine2>
      <LegacyUnixShimLine3>dir=${self%/*}</LegacyUnixShimLine3>
      <LegacyUnixShimLine4>if [ &quot;$dir&quot; = &quot;$self&quot; ]; then dir=.; fi</LegacyUnixShimLine4>
      <LegacyUnixShimLine5>exec &quot;$dir/aegis&quot; &quot;$@&quot;</LegacyUnixShimLine5>
    </PropertyGroup>

    <WriteLinesToFile
      File="$(PublishDir)aegis.cmd"
      Lines="@echo off"
      Overwrite="true"
      Condition="'$(OS)' == 'Windows_NT'" />

    <WriteLinesToFile
      File="$(PublishDir)aegis.cmd"
      Lines="$(LegacyWindowsShimCommand)"
      Overwrite="false"
      Condition="'$(OS)' == 'Windows_NT'" />

    <WriteLinesToFile
      File="$(PublishDir)opencode-aegis.cmd"
      Lines="@echo off"
      Overwrite="true"
      Condition="'$(OS)' == 'Windows_NT'" />

    <WriteLinesToFile
      File="$(PublishDir)opencode-aegis.cmd"
      Lines="$(LegacyWindowsShimCommand)"
      Overwrite="false"
      Condition="'$(OS)' == 'Windows_NT'" />

    <WriteLinesToFile
      File="$(PublishDir)aegis"
      Lines="#!/usr/bin/env sh"
      Overwrite="true"
      Condition="'$(OS)' != 'Windows_NT'" />

    <WriteLinesToFile
      File="$(PublishDir)aegis"
      Lines="$(LegacyUnixShimLine2);$(LegacyUnixShimLine3);$(LegacyUnixShimLine4);$(LegacyUnixShimLine5)"
      Overwrite="false"
      Condition="'$(OS)' != 'Windows_NT'" />

    <WriteLinesToFile
      File="$(PublishDir)opencode-aegis"
      Lines="#!/usr/bin/env sh"
      Overwrite="true"
      Condition="'$(OS)' != 'Windows_NT'" />

    <WriteLinesToFile
      File="$(PublishDir)opencode-aegis"
      Lines="$(LegacyUnixShimLine2);$(LegacyUnixShimLine3);$(LegacyUnixShimLine4);$(LegacyUnixShimLine5)"
      Overwrite="false"
      Condition="'$(OS)' != 'Windows_NT'" />

    <Exec
      Command="chmod +x &quot;$(PublishDir)aegis&quot;"
      Condition="'$(OS)' != 'Windows_NT'" />

    <Exec
      Command="chmod +x &quot;$(PublishDir)opencode-aegis&quot;"
      Condition="'$(OS)' != 'Windows_NT'" />
  </Target>

</Project>
