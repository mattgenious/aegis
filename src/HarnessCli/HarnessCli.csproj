<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>harness-cli</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HarnessCli</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HarnessCli.Backends\HarnessCli.Backends.csproj" />
    <ProjectReference Include="..\HarnessCli.Core\HarnessCli.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="WorkMapUi\dist\**\*"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="WriteLegacyCliAliasShims" AfterTargets="Publish">
    <PropertyGroup>
      <LegacyWindowsShimCommand>&quot;%~dp0harness-cli.exe&quot; %25*</LegacyWindowsShimCommand>
      <LegacyUnixShimLine2>self=$0</LegacyUnixShimLine2>
      <LegacyUnixShimLine3>dir=${self%/*}</LegacyUnixShimLine3>
      <LegacyUnixShimLine4>if [ &quot;$dir&quot; = &quot;$self&quot; ]; then dir=.; fi</LegacyUnixShimLine4>
      <LegacyUnixShimLine5>exec &quot;$dir/harness-cli&quot; &quot;$@&quot;</LegacyUnixShimLine5>
    </PropertyGroup>

    <WriteLinesToFile
      File="$(PublishDir)opencode-harness-cli.cmd"
      Lines="@echo off"
      Overwrite="true"
      Condition="'$(OS)' == 'Windows_NT'" />

    <WriteLinesToFile
      File="$(PublishDir)opencode-harness-cli.cmd"
      Lines="$(LegacyWindowsShimCommand)"
      Overwrite="false"
      Condition="'$(OS)' == 'Windows_NT'" />

    <WriteLinesToFile
      File="$(PublishDir)opencode-harness-cli"
      Lines="#!/usr/bin/env sh"
      Overwrite="true"
      Condition="'$(OS)' != 'Windows_NT'" />

    <WriteLinesToFile
      File="$(PublishDir)opencode-harness-cli"
      Lines="$(LegacyUnixShimLine2);$(LegacyUnixShimLine3);$(LegacyUnixShimLine4);$(LegacyUnixShimLine5)"
      Overwrite="false"
      Condition="'$(OS)' != 'Windows_NT'" />

    <Exec
      Command="chmod +x &quot;$(PublishDir)opencode-harness-cli&quot;"
      Condition="'$(OS)' != 'Windows_NT'" />
  </Target>

</Project>
